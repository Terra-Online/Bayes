{
  "name": "oem-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "dev:local": "node scripts/dev-with-google-proxy.mjs --env local",
    "deploy": "bash scripts/deploy-with-dev-vars.sh",
    "deploy:raw": "wrangler deploy",
    "waf:sync": "node scripts/sync-waf-allowlist.mjs --vars-file .waf.vars",
    "waf:check": "node scripts/sync-waf-allowlist.mjs --check --vars-file .waf.vars",
    "waf:sync:apply": "node scripts/sync-waf-allowlist.mjs --apply --vars-file .waf.vars",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:auth-runtime": "node --test scripts/test-auth-runtime.mjs",
    "test:worker-lifecycle": "node --test scripts/test-worker-lifecycle.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:logger": "tsc --noEmit -p oem-logger/tsconfig.json",
    "lint": "eslint .",
    "logger:check": "pnpm run typecheck:logger && eslint oem-logger && vitest run oem-logger/src/index.spec.ts && wrangler deploy --dry-run --config oem-logger/wrangler.toml",
    "check": "pnpm run format:check && pnpm run waf:check && pnpm run typecheck && pnpm run typecheck:logger && pnpm run lint && pnpm test && pnpm run test:auth-runtime && pnpm run test:worker-lifecycle && wrangler deploy --dry-run --config oem-logger/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "logger:dev": "wrangler dev --config oem-logger/wrangler.toml",
    "logger:db:migrate:local": "wrangler d1 migrations apply OEM_ERR --local --config oem-logger/wrangler.toml",
    "logger:db:migrate:remote": "wrangler d1 migrations apply OEM_ERR --remote --config oem-logger/wrangler.toml",
    "deploy:logger": "bash scripts/deploy-with-dev-vars.sh --logger-only",
    "logger:deploy": "pnpm run deploy:logger",
    "logger:deploy:raw": "wrangler deploy --config oem-logger/wrangler.toml",
    "logpush:plan": "node scripts/sync-logpush.mjs --plan",
    "logpush:status": "node scripts/sync-logpush.mjs --status",
    "logpush:apply": "node scripts/sync-logpush.mjs --apply",
    "glossary:update": "node scripts/update-google-glossary.mjs",
    "coverage-manifest:update": "node scripts/update-image-coverage-manifest.mjs",
    "progress:stats:rebuild": "node scripts/rebuild-progress-stats.mjs",
    "demo:ugc:sync": "node scripts/sync-demo-ugc.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@upstash/redis": "^1.35.3",
    "better-auth": "1.7.7",
    "hono": "^4.7.7",
    "nanoid": "^5.1.5",
    "resend": "^6.10.0",
    "skland-kit": "^0.3.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.24.0",
    "globals": "17.13.0",
    "lefthook": "^2.2.2",
    "oxfmt": "0.73.0",
    "typescript": "^5.8.3",
    "user-agents": "^2.1.161",
    "vitest": "3.2.7",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
