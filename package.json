{
  "name": "oem-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "dev:local": "node scripts/dev-with-google-proxy.mjs --env local",
    "deploy": "bash scripts/deploy-with-dev-vars.sh",
    "deploy:raw": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "glossary:update": "node scripts/update-google-glossary.mjs",
    "coverage-manifest:update": "node scripts/update-image-coverage-manifest.mjs",
    "progress:stats:rebuild": "node scripts/rebuild-progress-stats.mjs",
    "demo:ugc:sync": "node scripts/sync-demo-ugc.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@upstash/redis": "^1.35.3",
    "better-auth": "^1.6.0",
    "hono": "^4.7.7",
    "nanoid": "^5.1.5",
    "resend": "^6.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=22"
  }
}
