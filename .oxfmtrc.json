{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "sortSideEffects": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "**/.wrangler/**",
    "**/.wrangler-*/**",
    "**/dist/**",
    "**/coverage/**",
    ".history/**"
  ]
}
